<?xml version="1.0" ?>
<!--
  confined_space.sdf — Swarm Navigation World
  6m × 6m × 2.5m room, 6 obstacles, 2 infrastructure RGBD cameras
  Camera plugin: gz-sim-sensors-system (world-level, Gazebo Harmonic / gz-sim8)
  Box geometry: uses child <size> element, NOT xml attribute
-->
<sdf version="1.8">
<world name="confined_space">

  <physics type="ode">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1.0</real_time_factor>
    <real_time_update_rate>1000</real_time_update_rate>
  </physics>

  <!-- Required world plugins -->
  <plugin filename="gz-sim-physics-system"
          name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system"
          name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system"
          name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-contact-system"
          name="gz::sim::systems::Contact"/>
  <!-- ONE sensors plugin handles ALL camera/depth sensors in the world -->
  <plugin filename="gz-sim-sensors-system"
          name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
  <!-- IMU system needed if any IMU sensors added later -->
  <plugin filename="gz-sim-imu-system"
          name="gz::sim::systems::Imu"/>

  <scene>
    <ambient>0.5 0.5 0.5 1</ambient>
    <background>0.3 0.3 0.3 1</background>
    <shadows>true</shadows>
  </scene>

  <light name="sun" type="directional">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 10 0 0 0</pose>
    <diffuse>0.9 0.9 0.9 1</diffuse>
    <specular>0.3 0.3 0.3 1</specular>
    <attenuation>
      <range>1000</range><constant>0.9</constant>
      <linear>0.01</linear><quadratic>0.001</quadratic>
    </attenuation>
    <direction>-0.3 0.3 -0.9</direction>
  </light>

  <light name="ceil_light_w" type="point">
    <pose>-1.5 0 2.4 0 0 0</pose>
    <diffuse>0.8 0.8 0.7 1</diffuse>
    <specular>0.1 0.1 0.1 1</specular>
    <attenuation><range>8</range><constant>0.3</constant>
      <linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
  </light>

  <light name="ceil_light_e" type="point">
    <pose>1.5 0 2.4 0 0 0</pose>
    <diffuse>0.8 0.8 0.7 1</diffuse>
    <specular>0.1 0.1 0.1 1</specular>
    <attenuation><range>8</range><constant>0.3</constant>
      <linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
  </light>

  <!-- ======================================================== -->
  <!--  GROUND PLANE                                            -->
  <!-- ======================================================== -->
  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane><normal>0 0 1</normal><size>20 20</size></plane>
        </geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry>
          <plane><normal>0 0 1</normal><size>20 20</size></plane>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- ======================================================== -->
  <!--  ROOM WALLS  6m × 6m × 2.5m                             -->
  <!-- ======================================================== -->

  <model name="wall_south">
    <static>true</static><pose>0 -3.05 1.25 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>6.2 0.1 2.5</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>6.2 0.1 2.5</size></box></geometry>
        <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="wall_north">
    <static>true</static><pose>0 3.05 1.25 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>6.2 0.1 2.5</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>6.2 0.1 2.5</size></box></geometry>
        <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="wall_west">
    <static>true</static><pose>-3.05 0 1.25 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.1 6.2 2.5</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.1 6.2 2.5</size></box></geometry>
        <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="wall_east">
    <static>true</static><pose>3.05 0 1.25 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.1 6.2 2.5</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.1 6.2 2.5</size></box></geometry>
        <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- ======================================================== -->
  <!--  OBSTACLES                                               -->
  <!-- ======================================================== -->

  <model name="obs_box_1">
    <static>true</static><pose>0.5 -1.5 0.3 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.4 0.4 0.6</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.4 0.4 0.6</size></box></geometry>
        <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="obs_cyl_1">
    <static>true</static><pose>-1.8 0.5 0.4 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry></collision>
      <visual name="vis"><geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="obs_box_2">
    <static>true</static><pose>1.8 1.8 0.25 0 0 0.785</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.5 0.3 0.5</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.5 0.3 0.5</size></box></geometry>
        <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="obs_divider">
    <static>true</static><pose>0 0.5 0.5 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>1.2 0.1 1.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>1.2 0.1 1.0</size></box></geometry>
        <material><ambient>0.2 0.7 0.2 1</ambient><diffuse>0.2 0.7 0.2 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="obs_cyl_2">
    <static>true</static><pose>2.0 -1.0 0.35 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><cylinder><radius>0.15</radius><length>0.7</length></cylinder></geometry></collision>
      <visual name="vis"><geometry><cylinder><radius>0.15</radius><length>0.7</length></cylinder></geometry>
        <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="obs_Lshape_a">
    <static>true</static><pose>-2.0 2.0 0.3 0 0 0</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.6 0.1 0.6</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.6 0.1 0.6</size></box></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="obs_Lshape_b">
    <static>true</static><pose>-1.75 1.75 0.3 0 0 1.5708</pose>
    <link name="link">
      <collision name="col"><geometry><box><size>0.6 0.1 0.6</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.6 0.1 0.6</size></box></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- ======================================================== -->
  <!--  INFRASTRUCTURE CAMERA 1 — OAK-D Lite                   -->
  <!--  SW corner, 2m high, facing NE, 30° down                -->
  <!--  Sensor topics published via ros_gz_bridge:              -->
  <!--    /infra/cam_oak/rgb/image                              -->
  <!--    /infra/cam_oak/rgb/camera_info                        -->
  <!--    /infra/cam_oak/depth/image                            -->
  <!--    /infra/cam_oak/depth/camera_info                      -->
  <!--    /infra/cam_oak/depth/points                           -->
  <!-- ======================================================== -->
  <model name="infra_cam_oak">
    <static>true</static>
    <pose>-2.8 -2.8 2.0 0 0.5236 0.7854</pose>
    <link name="link">
      <visual name="body_vis">
        <geometry><box><size>0.091 0.038 0.0175</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <collision name="body_col">
        <geometry><box><size>0.091 0.038 0.0175</size></box></geometry>
      </collision>

      <!-- RGB — type="camera", NO per-sensor plugin needed -->
      <sensor name="cam_oak_rgb" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/infra/cam_oak/rgb/image</topic>
        <camera>
          <horizontal_fov>1.2043</horizontal_fov>
          <image><width>640</width><height>480</height><format>RGB_INT8</format></image>
          <clip><near>0.1</near><far>15.0</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
        </camera>
      </sensor>

      <!-- RGBD — type="rgbd_camera" gives both colour+depth+pointcloud -->
      <sensor name="cam_oak_rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/infra/cam_oak/depth</topic>
        <camera>
          <horizontal_fov>1.2043</horizontal_fov>
          <image><width>640</width><height>480</height><format>R_FLOAT32</format></image>
          <clip><near>0.1</near><far>10.0</far></clip>
        </camera>
      </sensor>

    </link>
  </model>

  <!-- ======================================================== -->
  <!--  INFRASTRUCTURE CAMERA 2 — Intel RealSense D435          -->
  <!--  NE corner, 2m high, facing SW, 30° down                -->
  <!--  Overlapping FOV with cam_oak for loop closure           -->
  <!-- ======================================================== -->
  <model name="infra_cam_rs">
    <static>true</static>
    <pose>2.8 2.8 2.0 0 0.5236 3.9270</pose>
    <link name="link">
      <visual name="body_vis">
        <geometry><box><size>0.099 0.025 0.024</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <collision name="body_col">
        <geometry><box><size>0.099 0.025 0.024</size></box></geometry>
      </collision>

      <!-- RGB -->
      <sensor name="cam_rs_rgb" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/infra/cam_rs/rgb/image</topic>
        <camera>
          <horizontal_fov>1.2043</horizontal_fov>
          <image><width>640</width><height>480</height><format>RGB_INT8</format></image>
          <clip><near>0.1</near><far>15.0</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
        </camera>
      </sensor>

      <!-- RGBD depth+pointcloud -->
      <sensor name="cam_rs_rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/infra/cam_rs/depth</topic>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image><width>640</width><height>480</height><format>R_FLOAT32</format></image>
          <clip><near>0.1</near><far>10.0</far></clip>
        </camera>
      </sensor>

    </link>
  </model>

</world>
</sdf>
